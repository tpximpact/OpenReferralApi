{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "OpenReferralApi.Services.SchemaWarmupBackgroundService": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Specification": {
    "WarmupEnabled": true,
    "WarmupStartupDelaySeconds": 5,
    "Urls": {
      "HSDS-3.0": "https://raw.githubusercontent.com/openreferral/specification/refs/heads/3.0/schema/openapi.json",
      "HSDS-3.2": "https://raw.githubusercontent.com/openreferral/specification/refs/heads/3.2/schema/openapi.json"
    },
    "DefaultProfileVersion": "",
    "ProfileVersionMappings": {}
  },
  "Database": {
    "ConnectionString": "",
    "DatabaseName": "",
    "ServicesCollection": ""
  },
  "FeedValidation": {
    "Enabled": false,
    "IntervalHours": 48,
    "RunAtMidnight": true
  },
  "Cache": {
    "Enabled": true,
    "ExpirationMinutes": 120,
    "MaxSizeMB": 100,
    "UseSlidingExpiration": true,
    "SlidingExpirationMinutes": 60
  },
  "SchemaResolution": {
    "WarnOnUnknownJsonSchemaDraft": true,
    "KnownJsonSchemaUrls": [
      "https://json-schema.org/draft/2020-12/schema",
      "https://json-schema.org/draft/2020-12/meta/core",
      "https://json-schema.org/draft/2020-12/meta/applicator",
      "https://json-schema.org/draft/2020-12/meta/unevaluated",
      "https://json-schema.org/draft/2020-12/meta/validation",
      "https://json-schema.org/draft/2020-12/meta/meta-data",
      "https://json-schema.org/draft/2020-12/meta/format-annotation",
      "https://json-schema.org/draft/2020-12/meta/content"
    ]
  },
  "Swagger": {
    "DocName": "v3",
    "Version": "3.1",
    "OpenApiSpecVersion": "OpenApi3_1_0",
    "Title": "Open Referral API",
    "Description": "API for validating and monitoring Open Referral data feeds"
  },
  "OpenApiValidation": {
    "OwnSchemaValidation": "Strict",
    "HsdsValidationMode": "Fast",
    "AllowUserSuppliedAuth": true,
    "ValidateSpecification": true,
    "TestEndpoints": true,
    "EnableMemoryCheckpointLogging": true,
    "TestOptionalEndpoints": true,
    "TreatOptionalEndpointsAsWarnings": true,
    "MaxRetainedResponseBodyCharacters": 262144,
    "MaxValidationErrorsPerResponse": 25
  }
}